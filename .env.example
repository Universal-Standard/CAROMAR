# CAROMAR Environment Variables
# CAROMAR works with zero configuration — users supply their own GitHub
# Personal Access Token through the UI. Everything below is optional.
# Full reference: docs/deployment/environment.md

# --- Actually used by server.js today ---

# Local dev server port (ignored on Netlify, which sets its own)
PORT=3000

# development | production | test
NODE_ENV=development

# Comma-separated list of origins allowed to call the API cross-origin,
# e.g. https://app.example.com,https://admin.example.com
# Leave unset to allow all origins (default, matches pre-1.2.0 behavior).
# Recommended to set explicitly in production deployments.
ALLOWED_ORIGINS=

# --- Reserved for future features (not read by server.js yet) ---

# GITHUB_CLIENT_ID=your_github_oauth_app_client_id
# GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# SESSION_SECRET=a_random_cryptographically_secure_string
